{
  "name": "@dukelib/sheets",
  "version": "0.1.16",
  "description": "High-performance Excel file library for Node.js, powered by Rust",
  "main": "lib.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/guseggert/duke-sheets.git",
    "directory": "bindings/nodejs"
  },
  "keywords": [
    "excel",
    "xlsx",
    "xls",
    "spreadsheet",
    "csv",
    "napi-rs",
    "rust"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "generated.d.ts",
    "lib.js"
  ],
  "napi": {
    "binaryName": "duke-sheets",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ],
    "package": {
      "name": "@dukelib/sheets"
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --js index.js --dts generated.d.ts",
    "build:debug": "napi build --platform --js index.js --dts generated.d.ts",
    "test": "vitest run",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "vitest": "^3.0.0"
  }
}
